# ---------------------------------------------------------------------------
# RMIT Store API — environment variables
#
# Copy this file to `.env` and edit. Everything here has a working default for
# local development except DATABASE_URL, which must point at a real Postgres.
#
#   cp .env.example .env
#
# Never commit a real `.env`. It is listed in .gitignore for a reason — and
# working out how to inject these values in a pipeline without checking them
# in is part of the assignment (AWS Secrets Manager, SSM Parameter Store,
# Jenkins credentials, Ansible Vault, and Kubernetes Secrets are all valid
# answers).
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------

# Which settings module to load. This one variable is how the same code runs
# on a laptop, on EC2 and in a container.
#   config.settings.dev   development
#   config.settings.prod  production (fails fast if SECRET_KEY/ALLOWED_HOSTS are unset)
#
# Read this carefully — the variable that chooses the settings module cannot
# be read *from* the settings module, so it is the one value here that is not
# handled like all the others.
#
# Under `manage.py`, precedence is highest first:
#   1. a real environment variable   export DJANGO_SETTINGS_MODULE=...
#   2. this file
#   3. manage.py's own default       config.settings.dev
#
# Under **gunicorn this file is not consulted at all**. wsgi.py runs before
# anything has read `.env`, so the line below has no effect there:
#   1. a real environment variable   gunicorn --env DJANGO_SETTINGS_MODULE=...
#   2. wsgi.py's own default         config.settings.prod
#
# That asymmetry is deliberate rather than an oversight. A `.env` left at the
# development default must never be able to boot a web server into DEBUG mode;
# a management command that does is a far smaller problem. If you want gunicorn
# on dev settings, say so explicitly on the command line.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate a real one for anything that is not your laptop:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=dev-only-insecure-key-change-me-before-you-deploy-anywhere

DEBUG=True

# Comma-separated. Required by config.settings.prod.
#   Local:  localhost,127.0.0.1
#   EC2:    <your-ec2-public-ip>,<your-ec2-private-ip>
ALLOWED_HOSTS=localhost,127.0.0.1

# Where the SPA is served from. Used to build the links inside password-reset
# and merchant-invitation emails, so it must be the URL a browser can reach.
#   Local:  http://localhost:5173
#   EC2:    http://<your-ec2-public-ip>
CLIENT_URL=http://localhost:5173


# --- Database --------------------------------------------------------------

# One URL rather than five separate variables — the same format RDS,
# Docker Compose and Kubernetes secrets all use.
#   Local:      postgres://rmit:rmit@localhost:5432/rmit_store
#   Same host:  postgres://rmit:rmit@127.0.0.1:5432/rmit_store
#   AWS RDS:    postgres://rmit:<password>@<rds-endpoint>.rds.amazonaws.com:5432/rmit_store
DATABASE_URL=postgres://rmit:rmit@localhost:5432/rmit_store

# Seconds to keep a connection open for reuse. Set to 0 if you put PgBouncer
# or RDS Proxy in front of the database.
CONN_MAX_AGE=60


# --- Cross-origin ----------------------------------------------------------
#
# Only relevant when the SPA and the API are served from different origins.
# If one nginx serves the built SPA and proxies /api/ to gunicorn, the browser
# sees a single origin and none of this matters. It starts mattering the
# moment you split the client and the server onto separate EC2 instances.

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Authentication --------------------------------------------------------

# Short access token, long refresh token. The session still lasts a week; a
# leaked access token only lasts an hour.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Seconds a password-reset link stays valid.
PASSWORD_RESET_TIMEOUT=3600
# Seconds a merchant invitation link stays valid (default 7 days).
MERCHANT_INVITE_MAX_AGE=604800


# --- Email -----------------------------------------------------------------
#
# The console backend prints emails to the server log, so password-reset and
# merchant-invitation links are visible without any mail server. That is the
# default and it is what you want locally.
#
# For real delivery via Amazon SES, no code changes — just these variables:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=email-smtp.ap-southeast-2.amazonaws.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=<ses-smtp-username>
#   EMAIL_HOST_PASSWORD=<ses-smtp-password>

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=RMIT Store <no-reply@rmit-store.local>
STORE_NOTIFICATION_EMAIL=store-admin@rmit-store.local


# --- Media storage ---------------------------------------------------------
#
# false: uploaded product images are written to server/media/ on local disk.
# true:  they go to an S3 bucket instead.
#
# Local disk breaks as soon as you run more than one application server — an
# image uploaded to instance A returns 404 from instance B. Switching this on
# is the fix, and provisioning the bucket plus an IAM instance role is the
# infrastructure-as-code exercise.
#
# Credentials are deliberately NOT read from settings. boto3 finds them from
# the environment locally and from an IAM instance profile on EC2 or IRSA on
# EKS — instance roles are the right answer, long-lived keys in a file are
# what this course is teaching you to stop doing.

USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-2
# Only for local testing against S3. On EC2/EKS, leave these unset and attach a role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=


# --- Store rules -----------------------------------------------------------

SALES_TAX_RATE=0.05
SALES_TAX_STATE_CODE=CA
SALES_TAX_STATE_NAME=California
# The display symbol is derived from this code — see config/settings/base.py.
STORE_CURRENCY=USD


# --- Operations ------------------------------------------------------------

LOG_LEVEL=INFO
TIME_ZONE=Australia/Melbourne

# Surfaced at GET /api/version/ so you can tell which build is serving traffic
# through a load balancer during a blue/green or canary rollout.
APP_VERSION=1.0.0
GIT_COMMIT=dev

# Rate limits. Format is DRF's: "<number>/<second|minute|hour|day>".
THROTTLE_AUTH=20/min
THROTTLE_CONTACT=5/hour
THROTTLE_MERCHANT_APPLY=5/hour
THROTTLE_NEWSLETTER=5/hour

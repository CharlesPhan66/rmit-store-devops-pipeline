# ---------------------------------------------------------------------------
# RMIT Store client — build-time environment
#
#   cp .env.example .env
#
# There is deliberately almost nothing here.
#
# The API base URL is NOT configured at build time. It is read at runtime from
# public/config.js, so that one built bundle can be deployed anywhere. See the
# comments in that file.
#
# VITE_API_BASE_URL below is only a fallback for `npm run dev` if you are not
# using the Vite proxy in vite.config.js. In development the proxy handles it
# and you should not need this at all.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=/api

# Where `npm run dev` forwards /api and /media. Only needed if your API is not
# on the usual port — for example if something else already has 8000.
# VITE_DEV_API_PROXY=http://localhost:8000

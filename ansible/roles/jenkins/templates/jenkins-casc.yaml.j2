# GENERATED BY ANSIBLE - DO NOT EDIT ON THE JENKINS HOST.
# Source of truth: ansible/roles/jenkins/templates/jenkins-casc.yaml.j2
#
# ${JENKINS_ADMIN_PASSWORD}, ${EMAIL_APP_PASSWORD} and ${GITHUB_PAT} are left
# as literal env-var placeholders on purpose: the configuration-as-code
# plugin resolves them from the Jenkins process environment at startup
# (written to /etc/systemd/system/jenkins.service.d/override.conf by
# ansible/roles/jenkins/tasks/main.yml - this RPM's jenkins.service unit has
# no EnvironmentFile=, so /etc/sysconfig/jenkins is never actually read),
# so no secret ever sits in this file on disk.
#
# If a key below stops matching the plugin's real schema after a plugin
# update, Jenkins logs the exact error at startup, and the fix is not to
# guess again: Manage Jenkins -> Configuration as Code -> "View Configuration"
# exports the authoritative YAML for whatever plugin versions are actually
# installed. extendedEmailPublisherConfiguration is the field most likely to
# need that treatment, since email-ext's JCasC export key has changed across
# major versions.

jenkins:
  systemMessage: "RMIT Store CI/CD - provisioned by Ansible. Do not click through the setup wizard by hand; edit the role instead."
  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: "{{ jenkins_admin_user }}"
          password: "${JENKINS_ADMIN_PASSWORD}"
  authorizationStrategy: "loggedInUsersCanDoAnything"

unclassified:
  location:
    url: "{{ jenkins_url }}"
    adminAddress: "{{ email_address }}"
  mailer:
    smtpHost: "smtp.gmail.com"
    smtpPort: "587"
    useSsl: false
    useTls: true
    charset: "UTF-8"
    smtpAuthUsername: "{{ email_address }}"
    smtpAuthPassword: "${EMAIL_APP_PASSWORD}"
  extendedEmailPublisherConfiguration:
    smtpServer: "smtp.gmail.com"
    smtpPort: "587"
    useSsl: false
    credentialsId: "gmail-smtp"
    defaultRecipients: "{{ email_address }}"
    defaultContentType: "text/plain"
    charset: "UTF-8"

credentials:
  system:
    domainCredentials:
      - credentials:
          - usernamePassword:
              scope: GLOBAL
              id: "gmail-smtp"
              username: "{{ email_address }}"
              password: "${EMAIL_APP_PASSWORD}"
              description: "Gmail SMTP app password - Extended E-mail Notification (build/test/deploy alerts)"
          - usernamePassword:
              scope: GLOBAL
              id: "github-pat"
              username: "x-access-token"
              password: "${GITHUB_PAT}"
              description: "GitHub PAT - checkout scm for {{ github_owner }}/{{ github_repo }}"

# Recreates the job from README 2.4 step 6 as code: same definition, same
# SCM, same branch and script path, plus the "GitHub hook trigger for GITScm
# polling" equivalent (githubPush()) that the manual walkthrough relied on
# the webhook alone to imply.
jobs:
  - script: >
      pipelineJob('{{ jenkins_job_name }}') {
        triggers {
          githubPush()
        }
        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('{{ github_repo_url }}')
                  credentials('github-pat')
                }
                branch('*/{{ jenkins_repo_branch }}')
              }
            }
            scriptPath('{{ jenkins_pipeline_script_path }}')
            lightweight(true)
          }
        }
      }

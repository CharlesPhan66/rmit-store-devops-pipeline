[Unit]
Description=RMIT Store API (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User={{ webapp_user }}
Group={{ webapp_group }}
WorkingDirectory={{ webapp_server_dir }}
EnvironmentFile={{ webapp_environment_file }}
ExecStart={{ webapp_virtualenv_dir }}/bin/gunicorn config.wsgi:application --bind {{ webapp_gunicorn_bind }} --workers {{ webapp_gunicorn_workers }} --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

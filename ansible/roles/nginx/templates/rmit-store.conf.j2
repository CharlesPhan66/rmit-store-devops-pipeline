# Reverse-proxy routes for the future Django/Gunicorn service.
# Keeping the original Host value is required for correct absolute URLs.
location ~ ^/(api|admin|static|healthz|readyz)(/|$) {
    proxy_pass http://{{ nginx_upstream_host }}:{{ nginx_upstream_port }};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
}

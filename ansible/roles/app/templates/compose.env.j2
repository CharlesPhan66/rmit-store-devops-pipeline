# GENERATED BY ANSIBLE - DO NOT EDIT ON THE HOST.
# Source of truth: ansible/roles/app/templates/compose.env.j2
# Values come from SSM under {{ ssm_prefix }}.
# Re-render with: ansible-playbook site.yml --limit tag_Role_staging

DJANGO_SETTINGS_MODULE=config.settings.prod

SECRET_KEY={{ secret_key }}

# Every address this API is allowed to be called on. The private IP is the one
# the Jenkins smoke stage uses; 127.0.0.1 is the container's own health check.
ALLOWED_HOSTS={{ allowed_hosts }}

# Points at the rmit_staging database on the shared RDS instance. There is no
# POSTGRES_PASSWORD any more: nothing here creates a database account, the
# instance already has one.
DATABASE_URL={{ database_url }}

# Read by `manage.py create_admin`, which the deploy runs before seed_demo.
# Passing them as environment rather than as command-line flags keeps the
# password out of the Jenkins log, out of the process table on this host, and
# out of ~/.bash_history.
DJANGO_SUPERUSER_EMAIL={{ admin_email }}
DJANGO_SUPERUSER_PASSWORD={{ admin_password }}

CLIENT_URL={{ client_url }}
CSRF_TRUSTED_ORIGINS={{ csrf_trusted_origins }}

# Staging runs over plain HTTP, so secure cookies would block sign-in.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Uploads go to S3 so every replica reads the same files. No AWS keys here:
# boto3 takes temporary credentials from the instance profile.
USE_S3=True
AWS_STORAGE_BUCKET_NAME={{ media_bucket }}
AWS_S3_REGION_NAME={{ aws_region }}
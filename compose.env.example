# Django

DJANGO_SETTINGS_MODULE=config.settings.prod

SECRET_KEY=REPLACE-WITH-A-GENERATED-KEY

ALLOWED_HOSTS=REPLACE-WITH-PUBLIC-IP,127.0.0.1,localhost

# Database
DATABASE_URL=postgres://rmit:REPLACE@REPLACE.rds.amazonaws.com:5432/rmit_staging

# Client origin
CLIENT_URL=http://REPLACE-WITH-PUBLIC-IP:8081
CSRF_TRUSTED_ORIGINS=http://REPLACE-WITH-PUBLIC-IP:8081

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Media storage
USE_S3=True
AWS_STORAGE_BUCKET_NAME=REPLACE-WITH-THE-STAGING-BUCKET
AWS_S3_REGION_NAME=us-east-1


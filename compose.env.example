# Configuration for the Compose stack in docker-compose.prod.yml.
#
#   cp compose.env.example compose.env
#   nano compose.env
#   chmod 600 compose.env
#
# compose.env is git-ignored and must stay that way: it holds SECRET_KEY and a
# database password. This file is the committed template. Never put a real
# value in it.
#
# Pass it on EVERY compose command, not just up. Compose re-parses the YAML on
# each invocation, and POSTGRES_PASSWORD below is substituted into it:
#
#   docker compose --env-file compose.env -f docker-compose.yml up -d
#   docker compose --env-file compose.env -f docker-compose.yml ps
#
# Format rules, which are NOT the same as Django's own .env:
#   - one KEY=value per line
#   - no quotes: SECRET_KEY='abc' stores the quote characters as part of the
#     value, and prod settings then refuse to boot
#   - no trailing comments; a # only starts a comment at the start of a line

# --- Django -------------------------------------------------------------------

# Redundant, because the image already sets it. Kept so that reading this file
# tells you which settings module the stack runs.
DJANGO_SETTINGS_MODULE=config.settings.prod

# Generate one with:
#   docker run --rm rmit-api:local python -c \
#     "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=REPLACE-WITH-A-GENERATED-KEY

# The host names this API answers to. Production settings enforce this and
# return 400 for anything else.
#
# 127.0.0.1 is required, not optional: the container's own health check calls
# http://127.0.0.1:8000/readyz/, so that request arrives with Host: 127.0.0.1.
# Leave it out and `docker compose ps` shows the API as unhealthy while the
# site works fine, which is a confusing place to start debugging.
ALLOWED_HOSTS=REPLACE-WITH-PUBLIC-IP,127.0.0.1,localhost

# --- Database -----------------------------------------------------------------
# Pick ONE of the two options below.
#
# Option A: the db container in docker-compose.prod.yml. Quick to start, fine
# for a local check, not a stand-in for production.
#
# The two passwords must be identical: POSTGRES_PASSWORD creates the account
# when the cluster is initialised, DATABASE_URL presents it when Django
# connects. POSTGRES_PASSWORD only takes effect on first creation of the
# volume, so changing it later requires `down -v` before it has any effect.
POSTGRES_PASSWORD=REPLACE-LETTERS-AND-DIGITS-ONLY
DATABASE_URL=postgres://rmit:SAME-AS-ABOVE@db:5432/rmit_store

# Option B: RDS. What staging and production should both use, because the
# things that break on deploy - security groups, secret delivery, RDS's
# non-superuser master account - only exist on this path.
#
# Comment out the db service in docker-compose.prod.yml and the depends_on
# block in migrate, then delete POSTGRES_PASSWORD above and use:
#
# DATABASE_URL=postgres://rmit:MASTER-PASSWORD@REPLACE.rds.amazonaws.com:5432/rmit_store
#
# `rmit` there is the username, not a password. URL-encode special characters
# in the password or django-environ will split the string in the wrong place:
# @ becomes %40, # becomes %23, : becomes %3A.

# --- Client origin ------------------------------------------------------------
# The SPA and the API are served from one origin here, so the browser makes no
# cross-origin request and CORS_ALLOWED_ORIGINS is not needed at all. These two
# are still used: CLIENT_URL for password-reset links, CSRF_TRUSTED_ORIGINS for
# form posts to the Django admin.
CLIENT_URL=http://REPLACE-WITH-PUBLIC-IP:8080
CSRF_TRUSTED_ORIGINS=http://REPLACE-WITH-PUBLIC-IP:8080

# Production settings default both of these to True, which stops sign-in from
# working over plain HTTP. Set them back to True once there is TLS in front.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Media storage ------------------------------------------------------------
# Uploaded images go to S3 so every API replica reads the same files. With this
# off, an image uploaded through one replica 404s from the others.
#
# No AWS keys here, deliberately: boto3 takes temporary credentials from the
# EC2 instance profile. If /readyz/ reports storage unavailable while
# `aws s3 ls` works on the host, the cause is the IMDS hop limit, not this file.
USE_S3=True
AWS_STORAGE_BUCKET_NAME=REPLACE-WITH-BUCKET-NAME
AWS_S3_REGION_NAME=us-east-1

# --- Build stamp (optional) ---------------------------------------------------
# GET /api/version/ reports these, which is how you confirm which build is
# serving traffic through a load balancer. Normally they are stamped into the
# image at build time with --build-arg; setting them here overrides that.
#
# APP_VERSION=1.0.0
# GIT_COMMIT=abc1234

# --- Email (optional) ---------------------------------------------------------
# The default console backend prints mail to the API log, which is enough for
# password-reset links. Real deliveryugh Amazon SES needs no code change,
# only these variables. See app/server/.env.example for the full list.
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587 thro